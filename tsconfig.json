{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ES2022",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": ["node"],
    "resolveJsonModule": true,
    "paths": {
      "swc-plugin-transform-invariant-warning/source-filter": [
        "./packages/transform-invariant-warning/src/source-filter.mts"
      ]
    }
  },
  "include": ["scripts/**/*.mts", "commitlint.config.mts", "packages/*/tests/**/*.mts"]
}
