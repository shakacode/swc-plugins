{
  "name": "swc-plugins-workspace",
  "private": true,
  "scripts": {
    "build": "cargo build --locked --release --target wasm32-wasip1 && node scripts/copy-wasm.mjs",
    "test": "cargo test --locked --workspace && pnpm test:js && pnpm test:commitlint",
    "test:js": "pnpm -r test",
    "lint": "oxlint -c .oxlintrc.jsonc --deny-warnings . && cargo clippy --locked --workspace --all-targets -- -D warnings",
    "format": "oxfmt -c .oxfmtrc.jsonc . && cargo fmt --all",
    "format:check": "oxfmt -c .oxfmtrc.jsonc --check . && cargo fmt --all --check",
    "types:generate": "UPDATE_BINDINGS=1 cargo test --locked --lib exported_options_are_current",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "commitlint": "commitlint",
    "commitlint:ci": "node scripts/commitlint-ci.mts",
    "test:commitlint": "node --test --test-isolation=none scripts/commitlint.test.mts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@jridgewell/trace-mapping": "0.3.31",
    "@swc/core": "1.16.21",
    "@types/node": "24.19.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "rspack-earliest": "npm:@rspack/core@2.2.0",
    "rspack-latest": "npm:@rspack/core@^2.2.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@8.14.1"
}
