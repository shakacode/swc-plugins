{
  "name": "@shakacode/swc-plugin-utils",
  "version": "0.1.0",
  "description": "Shared host utilities for SWC transform plugins",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shakacode/swc-plugins.git",
    "directory": "packages/swc-plugin-utils"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test --test-isolation=none tests/*.test.mts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:js": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@shakacode/swc-plugin-test-utils": "workspace:*"
  }
}
